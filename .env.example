# Copy this file to .env for local testing and fill in real values.
# In GitHub Actions these are loaded from repo Secrets — see README.md.

# Telegram
TELEGRAM_BOT_TOKEN=8XXXXXXXXX:AAH-xxx...
TELEGRAM_CHANNEL_ID=-1002XXXXXXXXXX
TELEGRAM_USER_ID=XXXXXXXX

# Gemini (Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Optional: Anthropic (only if you switch to Claude later)
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Behaviour
MIN_SCORE_TO_PUBLISH=8          # Posts with score < this won't publish
MAX_POSTS_PER_RUN=2             # Don't spam — cap per cron run
DRY_RUN=false                   # If true, prints but doesn't publish or modify state
